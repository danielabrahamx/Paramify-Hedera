# .env.example
# 
# This file shows the structure of required environment variables.
# DO NOT commit real values - copy to .env and fill with actual credentials.
# .env should be added to .gitignore
#

# Backend Server Port
PORT=3001

# Hedera Testnet Smart Contracts
# These are set after deployment - update with your deployed addresses
PARAMIFY_ADDRESS=your_paramify_contract_address_here
MOCK_ORACLE_ADDRESS=your_mock_oracle_contract_address_here

# Hedera Testnet RPC Configuration
RPC_URL=https://testnet.hashio.io/api

# Hedera Operator Credentials
# IMPORTANT: Never commit your actual private key!
# Only set this locally in .env (which is .gitignored)
HEDERA_OPERATOR_KEY=your_operator_private_key_here
